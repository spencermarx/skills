{
  "name": "whiteboard-bridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "whiteboard-bridge": "index.ts"
  },
  "scripts": {
    "start": "echo 'boot the board through /whiteboard (SKILL.md §1 step 3), not npm' >&2; exit 1",
    "typecheck": "tsc --noEmit",
    "test": "fail=0; for f in *.test.ts; do echo \"== $f\"; node --import tsx \"$f\" || fail=1; done; exit $fail",
    "test:sync-corruption": "node --import tsx sync-corruption.test.ts",
    "test:busy-loop": "node --import tsx busy-loop.test.ts"
  },
  "dependencies": {
    "@tldraw/state": "^5.4.2",
    "@tldraw/store": "^5.4.2",
    "@tldraw/sync-core": "^5.4.2",
    "@tldraw/tlschema": "^5.4.2",
    "express": "^4.21.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
